// 基本的な構成図テンプレート
//
// 新しい構成図を作る場合は、このファイルをコピーして機器名・接続を書き換える。
// 色・枠線・文字サイズ等のスタイルはここには書かない（diagram-style.jsonとrender.pyが管理する）。
// 書き方の詳細はこのフォルダのREADME.mdを参照すること。
//
// グラフの種類：
//   "graph"は、矢印のない、向きを持たない接続（相互の通信等）を表す。
//   一方向の決まったデータの流れを表したい場合は、"digraph"と"->"（矢印つき接続）に変更してよい。
graph 構成図テンプレート {
    // 図全体の向き（LR＝左から右。TB＝上から下にしたい場合は "TB" に変更する）
    rankdir=LR;

    // 機器（ノード）の定義。ラベルは表示したい名称を書く。
    機器A [label="機器A"];
    機器B [label="機器B"];

    // 接続（エッジ）の定義。label には通信方式等を書く。
    機器A -- 機器B [label="接続方式"];
}
